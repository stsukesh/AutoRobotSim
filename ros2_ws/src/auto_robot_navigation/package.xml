<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>auto_robot_navigation</name>
  <version>1.0.0</version>
  <description>SLAM Toolbox mapping, Nav2 autonomous navigation, and mission coordinator</description>
  <maintainer email="robotics@example.com">Robotics Developer</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav2_bringup</depend>
  <depend>nav2_simple_commander</depend>
  <depend>nav2_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>slam_toolbox</depend>
  <depend>auto_robot_description</depend>
  <depend>auto_robot_gazebo</depend>
  <depend>auto_robot_localization</depend>
  <depend>auto_robot_perception</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
